---
import Layout from '../layouts/Layout.astro';
import HeaderOrganism from '../components/organisms/HeaderOrganism';
import HeroOrganism from '../components/organisms/HeroOrganism';
import MetricsBarOrganism from '../components/organisms/MetricsBarOrganism';
import HowItWorksOrganism from '../components/organisms/HowItWorksOrganism';
import BenefitsOrganism from '../components/organisms/BenefitsOrganism';
import ServicesPricingOrganism from '../components/organisms/ServicesPricingOrganism';
import TestimonialsOrganism from '../components/organisms/TestimonialsOrganism';
import LocationMapsOrganism from '../components/organisms/LocationMapsOrganism';
import AboutOrganism from '../components/organisms/AboutOrganism';
import FAQOrganism from '../components/organisms/FAQOrganism';
import FinalCTAOrganism from '../components/organisms/FinalCTAOrganism';
import FooterOrganism from '../components/organisms/FooterOrganism';
import companyData from '../data/infos.json';
import FloatingWhatsAppButton from '../components/molecules/FloatingWhatsAppButton';
const { 
  whatsappLink, 
  units, 
  differentials,
  services, 
  testimonials,
  metrics,
  faqs,
  benefits,
  about,
  company,
  socialProof,
  cta,
  contact,
  servicesTitle,
  servicesSubtitle,
  testimonialsTitle,
  testimonialsSubtitle,
  faqTitle,
  faqSubtitle,
  benefitsTitle,
  benefitsSubtitle
} = {
  whatsappLink: companyData.contact.whatsapp + '?text=' + encodeURIComponent(companyData.contact.whatsappMessage),
  units: companyData.units,
  differentials: companyData.differentials,
  services: companyData.services.items,
  testimonials: companyData.testimonials.items,
  metrics: companyData.metrics.items,
  faqs: companyData.faq.items,
  benefits: companyData.benefits.items,
  about: companyData.about,
  company: companyData.company,
  contact: companyData.contact,
  socialProof: companyData.socialProof,
  cta: companyData.cta,
  servicesTitle: companyData.services.title,
  servicesSubtitle: companyData.services.subtitle,
  testimonialsTitle: companyData.testimonials.title,
  testimonialsSubtitle: companyData.testimonials.subtitle,
  faqTitle: companyData.faq.title,
  faqSubtitle: companyData.faq.subtitle,
  benefitsTitle: companyData.benefits.title,
  benefitsSubtitle: companyData.benefits.subtitle
};
---

<Layout title={`${companyData.company.name} | ${companyData.company.tagline}`}>
  <HeaderOrganism client:load whatsappLink={whatsappLink} units={units} contact={contact} />
  
  <main>
    <HeroOrganism 
      client:idle
      whatsappLink={whatsappLink} 
      units={units}
      differentials={differentials} 
      company={company}
      contact={contact}
      cta={cta}
      socialProof={socialProof}
    />
    <MetricsBarOrganism metrics={metrics} />
    <HowItWorksOrganism
      client:visible
      howItWorks={companyData.howItWorks}
      units={units}
      ctaLabel={cta.primary}
    />
    <BenefitsOrganism benefits={benefits} benefitsTitle={benefitsTitle} benefitsSubtitle={benefitsSubtitle} />
    <ServicesPricingOrganism 
      client:visible
      whatsappLink={whatsappLink} 
      units={units}
      services={services}
      servicesTitle={servicesTitle}
      servicesSubtitle={servicesSubtitle}
      priceDisclaimer={companyData.services.priceDisclaimer}
      specialties={companyData.services.specialties}
    />
    <TestimonialsOrganism 
      testimonials={testimonials} 
      metrics={metrics}
      testimonialsTitle={testimonialsTitle}
      testimonialsSubtitle={testimonialsSubtitle}
      rating={company.rating.score}
      totalReviews={company.rating.reviewsCount}
    />
    <LocationMapsOrganism client:visible units={units} />
    <FAQOrganism 
      client:visible
      faqs={faqs}
      faqTitle={faqTitle}
      faqSubtitle={faqSubtitle}
    />
    <FinalCTAOrganism client:visible units={units} ctaLabel={cta.primary} />
  </main>

  <FooterOrganism units={units} company={company} />

  <!-- BOTÃO FLUTUANTE WHATSAPP / BARRA MOBILE -->
  <FloatingWhatsAppButton client:idle units={units} primaryTel={contact.phonePrimaryTel} /> 
</Layout>

