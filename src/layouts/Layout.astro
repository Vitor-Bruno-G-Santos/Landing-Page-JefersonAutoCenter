---

import '../styles/global.css';
import companyData from '../data/infos.json';

interface Props {
	title?: string;
}

const { title = companyData.company.name } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={companyData.company.description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#001f5c] text-gray-100 font-sans antialiased">
		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Inter', sans-serif;
	}
</style>
